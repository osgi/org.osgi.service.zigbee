                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.23.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final short UNLIMITED_BROADCAST_RADIUS = 255</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
Value constant to set an unlimited broadcast radius.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeHost.broadcast-int-ZCLFrame-">
                  <fo:block>
