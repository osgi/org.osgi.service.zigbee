                                 <fo:block>panId</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>The network Personal Area Network identifier (PAN ID)</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
