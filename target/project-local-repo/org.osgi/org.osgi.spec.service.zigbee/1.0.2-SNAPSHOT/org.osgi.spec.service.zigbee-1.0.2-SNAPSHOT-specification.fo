                             letter-spacing="0.08em"
                             hyphenate="false">ZCLException</fo:inline>
               </fo:basic-link> extends the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeException">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeException</fo:inline>
               </fo:basic-link>.
    It holds information about the different ZigBee ZCL layers. Error codes
    specified by ZigBee Alliance are conveyed by the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeException.errorCode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">errorCode</fo:inline>
               </fo:basic-link> field of <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLException">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLException</fo:inline>
               </fo:basic-link>
    objects.</fo:block>
         </fo:block>
