                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">byte[4]</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes.DATE">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">DATE</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>Date</fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">byte[4]</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes.UTC_TIME">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">UTC_TIME</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>UTC Time</fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Long</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes.IEEE_ADDRESS">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">IEEE_ADDRESS</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>IEEE address (MAC-48,EUI-48/64)</fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">BigInteger</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes.SECURITY_KEY_128">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">SECURITY_KEY_128</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
