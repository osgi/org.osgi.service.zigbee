                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.5.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String ID = "zigbee.cluster.id"</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
