                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.25.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final short COORDINATOR = 2</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
Constant value used as logical type value when the ZigBee device is a
 Coordinator.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeNode.EXTENDED_PAN_ID">
                  <fo:block>
                     <fo:block>
