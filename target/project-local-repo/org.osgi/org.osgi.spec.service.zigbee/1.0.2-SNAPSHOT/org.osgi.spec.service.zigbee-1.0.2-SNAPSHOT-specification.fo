                                             <fo:block>149.31.19.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String DEVICE_CATEGORY = "ZigBee"</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
Constant used by all ZigBee devices indicating the device category. It is
 a <fo:inline font-weight="bold">mandatory</fo:inline> service property for this service.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeEndpoint.DEVICE_ID">
