                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>the 16-bit group address.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeGroup.groupcast-int-ZCLFrame-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.22.3</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract ZCLCommandResponseStream groupcast(int clusterId, ZCLFrame frame)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>clusterId</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>a cluster identifier.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>frame</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>a command frame sequence.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Sends a ZCL frame to the group represented by this service. The returned
 stream will provide the invocation response(s) in an asynchronous way.
 
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 The source endpoint is not specified in this method call. To send the
 appropriate message on the network, the base driver must generate a
 source endpoint. The latter must not correspond to any exported endpoint.</fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>a {@link ZCLCommandResponseStream} to collect every ZCL frame one
         after the other in case of multiple responses.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeGroup.groupcast-int-ZCLFrame-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.22.4</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract ZCLCommandResponseStream groupcast(int clusterId, ZCLFrame frame, String exportedServicePID)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>clusterId</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>a cluster identifier.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>frame</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>a command frame sequence.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>exportedServicePID</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>: the source endpoint of the command request.
        In targeted situations, the source endpoint is the valid service
        PID of an exported endpoint.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Sends a ZCL frame to the ZigBee group represented by this service. The
 returned stream will provide the invocation response(s) in an
 asynchronous way.
 
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 This method is to be used by applications when the targeted device has to
 distinguish between source endpoints of the message. For instance, alarms
 cluster (see 3.11 Alarms Cluster in [ZCL]) generated events are
 differently interpreted if they come from the oven or from the intrusion
 alert system.</fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>a {@link ZCLCommandResponseStream} to collect every ZCL frame one
         after the other in case of multiple responses.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeGroup.joinGroup-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.22.5</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract Promise&lt;Void&gt; joinGroup(String pid)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>pid</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>{@link String} representing the service PID of the
        {@link ZigBeeEndpoint} to add to this Group.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Requests an endpoint to join this group. This method may be invoked on
 exported and imported endpoints. In the former case, the ZigBee Base
 Driver should rely on the <fo:inline font-style="italic">APSME-ADD-GROUP</fo:inline> API defined by the
 ZigBee Specification, or it will use the proper commands of the
 <fo:inline font-style="italic">Groups</fo:inline> cluster of the ZigBee Specification Library.
 
 As described in "Table 2.15 APSME-ADD-GROUP.confirm Parameters" of the
 ZigBee specification 1_053474r17ZB_TSC-ZigBee-Specification.pdf, an
 add_group request can have the following status:
 {@link APSException#SUCCESS}, {@link APSException#INVALID_PARAMETER} or
 {@link APSException#TABLE_FULL}. When the joining is performed remotely
 on an imported {@link ZigBeeEndpoint}, it may also fail because the
 command is not supported by the remote endpoint, or because the remote
 device cannot perform the operation at the moment (see
 {@link ZCLException}).
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>A promise representing the completion of this asynchronous call.
         {@link Promise#getFailure()} returns null if the cluster has been
         successfully bound. The adequate {@link ZigBeeException} is
         returned otherwise.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeGroup.leaveGroup-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.22.6</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract Promise&lt;Void&gt; leaveGroup(String pid)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>pid</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>{@link String} representing the service PID of the
        {@link ZigBeeEndpoint} to remove from this Group.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Requests an endpoint to leave this group. This method may be invoked on
 exported and imported endpoints. In the former case, the ZigBee Base
 Driver should rely on the <fo:inline font-style="italic">APSME-REMOVE-GROUP </fo:inline> API defined by the
 ZigBee Specification, or it will use the proper commands of the
 <fo:inline font-style="italic">Groups</fo:inline> cluster of the ZigBee Specification Library.
 
 As described in "Table 2.17 APSME-REMOVE-GROUP.confirm Parameters" of the
 ZigBee specification 1_053474r17ZB_TSC-ZigBee-Specification.pdf, a
 remove_group request can have the following status:
 {@link APSException#SUCCESS}, {@link APSException#INVALID_GROUP} or
 {@link APSException#INVALID_PARAMETER}. When the command is invoked
 remotely on an imported {@link ZigBeeEndpoint}, it may also fail because
 the command is not supported by the remote endpoint, or because the
 remote device cannot perform the operation at the moment (see
 {@link ZCLException}).
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>A promise representing the completion of this asynchronous call.
         {@link Promise#getFailure()} returns null if the cluster has been
         successfully bound. The adequate {@link ZigBeeException} is
         returned otherwise.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="org.osgi.service.zigbee.ZigBeeHost">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>149.31.23</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>public abstract ZigBeeHost<fo:block line-height="0pt"/> extends ZigBeeNode</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
This interface represents the machine that hosts the code to run a ZigBee
 device or client. This machine is, for example, the ZigBee chip/dongle that
 is controlled by the base driver (below/under the OSGi execution
 environment).
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 ZigBeeHost is more than a ZigBeeNode.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 It must be registered as a OSGi service.
 
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 Even if not specified explicitly in the javadoc, any method of this interface
 must throw an {@link IllegalArgumentException} exception if a or one of the
 passed arguments has a value not admitted by the method.</fo:block>
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         start-indent="0pt"
                         relative-align="baseline">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block text-align="end" font-style="italic">
                              <fo:block>No Implement</fo:block>
                           </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Consumers of this API must not implement this interface</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeHost.UNLIMITED_BROADCAST_RADIUS">
