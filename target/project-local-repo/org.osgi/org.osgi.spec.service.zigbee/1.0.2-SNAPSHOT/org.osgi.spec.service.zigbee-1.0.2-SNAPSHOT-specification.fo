               <fo:block id="org.osgi.service.zigbee.APSException.APSException-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.2.19</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public  APSException(String errorDesc)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>errorDesc</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>exception an error description.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Creates a {@link APSException} containing only a description, but no
 error codes. If issued on this exception the {@link #getErrorCode()} and
 {@link #getZigBeeErrorCode()} methods return the {@link #UNKNOWN_ERROR}
 constant.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.APSException.APSException-int-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.2.20</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public  APSException(int errorCode, String errorDesc)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>errorCode</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>One of the error codes defined in this interface or
        {@link #UNKNOWN_ERROR} if the actual error is not listed in this
        interface. In this case if the native ZigBee error code is known,
        it is preferred to use the {@link #APSException(int, int, String)}
        constructor, passing {@link #UNKNOWN_ERROR} as first parameter and
        the native ZigBee error as the second.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>errorDesc</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>An error description which explain the type of problem.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Creates a {@link APSException} containing a specific
 {@code errorCode}. Using this constructor with {@code errorCode} set to
 {@link #UNKNOWN_ERROR} is equivalent to call
 {@link #APSException(String)}.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.APSException.APSException-int-int-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.2.21</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public  APSException(int errorCode, int zigBeeErrorCode, String errorDesc)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>errorCode</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>One of the error codes defined in this interface or
        {@link #UNKNOWN_ERROR} the actual error is not covered in this
        interface. In this case the {@code zigBeeErrorCode} parameter must
        be the actual status code returned by the ZigBee stack.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>zigBeeErrorCode</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>The actual APS status code or
        {@link #UNKNOWN_ERROR} if this status is unknown.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>errorDesc</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>An error description which explain the type of problem.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Creates a {@link APSException} containing a specific
 {@code errorCode} or {@code zigBeeErrorCode}. Using this constructor with
 both the {@code errorCode} and {@code zigBeeErrorCode} set to
 {@link #UNKNOWN_ERROR} is equivalent to call
 {@link #APSException(String)}.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="org.osgi.service.zigbee.ZCLAttribute">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>149.31.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>public abstract ZCLAttribute<fo:block line-height="0pt"/> extends ZCLAttributeInfo</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
This interface represents a ZCLAttribute.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 Its extends ZCLAttributeInfo to add methods to read and write the ZCL
 attribute from and to the ZigBee node with respectively the
 {@link #getValue()} and {@link #setValue(Object)} methods.</fo:block>
               <fo:block id="org.osgi.service.zigbee.ZCLAttribute.ID">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.3.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String ID = "zigbee.attribute.id"</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
Property key for the optional attribute id of a ZigBee Event Listener.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZCLAttribute.getValue--">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.3.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract Promise&lt;Object&gt; getValue()</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Gets the current value of the attribute.
 
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 As described in section <fo:inline font-style="italic">2.4.1.3 Effect on Receipt</fo:inline> of the ZCL
 specification, a <fo:inline font-style="italic">Read attributes</fo:inline> command can have the following
 status: {@link ZCLException#SUCCESS},
 {@link ZCLException#UNSUPPORTED_ATTRIBUTE}, or
 {@link ZCLException#INVALID_VALUE}.</fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>A promise representing the completion of this asynchronous call.
         The response object returned by {@link Promise#getValue()} is the
         requested attribute value in the relevant Java data type (see
         {@link #getDataType()} method and
         {@link ZCLDataTypeDescription#getJavaDataType()}) or in
         {@code byte[]} if {@link #getDataType()} returns null. The
         response object is null if an
         {@link ZCLException#UNSUPPORTED_ATTRIBUTE} or
         {@link ZCLException#INVALID_VALUE} error occurs and the adequate
         ZCLException is returned by {@link Promise#getFailure()} .</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZCLAttribute.setValue-Object-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
