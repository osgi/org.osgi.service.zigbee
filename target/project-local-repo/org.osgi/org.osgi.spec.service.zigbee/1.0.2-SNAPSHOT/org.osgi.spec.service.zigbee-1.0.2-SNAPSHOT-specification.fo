                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
The type of an attribute identifier.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.zigbee.ZigBeeDataTypes.BACNET_OID">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
