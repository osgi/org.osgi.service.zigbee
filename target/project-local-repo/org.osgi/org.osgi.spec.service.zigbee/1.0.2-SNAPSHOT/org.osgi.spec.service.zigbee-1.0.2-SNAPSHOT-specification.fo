                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>A {@link Promise} representing the completion of this
         asynchronous call. The promise will be resolved with
         {@code short[]} containing the command identifiers supported by
         the cluster.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
