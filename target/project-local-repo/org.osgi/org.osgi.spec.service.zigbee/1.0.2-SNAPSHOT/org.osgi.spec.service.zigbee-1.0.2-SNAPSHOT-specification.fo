                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">byte[8]</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes.UNKNOWN">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">UNKNOWN</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>Unknown</fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em"/>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                  </fo:table-body>
               </fo:table>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:inline font-size="75%" baseline-shift="super">1</fo:inline> BACnet OID (Object identifier) data
    type is included to allow interworking with BACnet (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-ref-ashrae-standard">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[5] <fo:inline font-style="italic">ASHRAE 135-2004 Standard</fo:inline>
                  </fo:inline>
               </fo:basic-link>). The format is described
    in the referenced standard.</fo:block>
         </fo:block>
         <fo:block id="service.zigbee.implementinganendpoint">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Implementing a ZigBee Endpoint</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.20</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Implementing a ZigBee Endpoint</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">OSGi services can also be exported as ZigBee endpoints to the local
    networks, in a way that is transparent to typical ZigBee devices
    endpoints. This allows developers to bridge legacy devices to ZigBee
    networks. A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link> MUST be registered with the following properties
    to export an OSGi service as a ZigBee endpoint:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e1315">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1316">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.ZIGBEE_EXPORT">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZIGBEE_EXPORT</fo:inline>
                           </fo:basic-link> – To indicate that the endpoint is an
        exportable endpoint.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">An OSGi platform can be connected to multiple ZigBee networks. <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.HOST_PID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">HOST_PID</fo:inline>
               </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">PAN_ID</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.EXTENDED_PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">EXTENDED_PAN_ID</fo:inline>
               </fo:basic-link> are used to select the appropriate network. At
    least one of these properties MUST be specified. If provided, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.HOST_PID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">HOST_PID</fo:inline>
               </fo:basic-link> has priority over <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">PAN_ID</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.EXTENDED_PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">EXTENDED_PAN_ID</fo:inline>
               </fo:basic-link> to identify the host that is targeted for
    export.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">In addition, the ZigBeeEndpoint service MUST declare the same
    properties as an imported endpoint. The bundle registering endpoint
    services must make sure these properties are set accordingly or that none
    of these properties are set. In case a ZigBee host is not initialized yet
    or the base driver is not active on the OSGi framework, an endpoint
    implementation MAY not have any of the above identifiers.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">If the Base Driver is active and at a ZigBee host is started, then
    the Base Driver makes an attempt to export the endpoint on the ZigBee
    network associated to the ZigBee <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.HOST_PID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">HOST_PID</fo:inline>
               </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">PAN_ID</fo:inline>
               </fo:basic-link> or <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.EXTENDED_PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">EXTENDED_PAN_ID</fo:inline>
               </fo:basic-link>. The associated ZigBeeNode object MUST be one of
    the available ZigBeeHost objects. Every time an endpoint is registered or
    unregistered with both <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.ZIGBEE_EXPORT">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZIGBEE_EXPORT</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">PAN_ID</fo:inline>
               </fo:basic-link> and/or <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.EXTENDED_PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">EXTENDED_PAN_ID</fo:inline>
               </fo:basic-link> properties set, the associated ZigBeeHost service
    is modified accordingly (<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.getEndpoints--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getEndpoints()</fo:inline>
               </fo:basic-link> returns a different array of ZigBeeEndpoint
    objects).</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">If - and only if - an error is detected on the properties of the
    ZigBee endpoint to be exported, then the Base Driver calls the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.notExported-ZigBeeException-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">notExported(ZigBeeException)</fo:inline>
               </fo:basic-link> method with a relevant ZigBeeException object as
    the input argument. The method SHOULD be called even if a ZigBee Host is
    not started.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The endpoint has to be registered with an ID that is unique. If the
    chosen ID already exists as a property of a local endpoint with the same
    host or if it already exists in an optional cache of the base driver, the
    base driver calls the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.notExported-ZigBeeException-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">notExported(ZigBeeException)</fo:inline>
               </fo:basic-link> method with the ZigBeeException object as the
    input argument with <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeException.OSGI_EXISTING_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">OSGI_EXISTING_ID</fo:inline>
               </fo:basic-link> error code. The base driver may keep IDs in a
    cache for endpoints that might come back in the registry. The range of
    potential IDs is 1-240 according to <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-ref-zigbee-specification">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[1] <fo:inline font-style="italic">ZigBee Specification</fo:inline>
                  </fo:inline>
               </fo:basic-link>.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The reader must note that a same ZigBeeEndpoint object cannot be
    registered several times with distinct PAN IDs since the<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.getNodeAddress--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getNodeAddress()</fo:inline>
               </fo:basic-link> method can only return one ZigBee node
    address.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">If the PAN ID corresponds to more than one ZigBeeHost service, the
    ZigBeeEndpoint MUST define the Extended PAN ID property which uniquely
    identifies a ZigBee network. The base driver will call <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.notExported-ZigBeeException-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">notExported(ZigBeeException)</fo:inline>
               </fo:basic-link> with the error code <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeException.OSGI_MULTIPLE_HOSTS">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">OSGI_MULTIPLE_HOSTS</fo:inline>
               </fo:basic-link> if the Extended PAN ID property is not properly
    defined in this specific situation.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Moreover, if the HOST PID corresponds to more than one ZigBeeHost,
    the base driver will also call <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.notExported-ZigBeeException-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">notExported(ZigBeeException)</fo:inline>
               </fo:basic-link> with the error code <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeException.OSGI_MULTIPLE_HOSTS">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">OSGI_MULTIPLE_HOSTS</fo:inline>
               </fo:basic-link>.</fo:block>
         </fo:block>
         <fo:block id="d1850e1382">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Event API</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.21</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Event API</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Eventing is available in import and export situations:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e1385">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1386">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>External events from the network must be dispatched to listeners
        inside the OSGi Service Platform. The ZigBee Base driver is
        responsible for mapping the network events to internal listener
        events.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1388">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Implementations of ZigBee endpoints must send out events to
        local listeners. The ZigBee Base driver dispatches events to the
        network from its own listeners.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">ZigBee events are sent using the whiteboard pattern, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-ref-whiteboard-pattern">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[6] <fo:inline font-style="italic">Listeners considered harmful: The whiteboard pattern</fo:inline>
                  </fo:inline>
               </fo:basic-link>, in which a bundle
    interested in receiving the ZigBee events registers an object implementing
    the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLEventListener</fo:inline>
               </fo:basic-link> interface. The service MUST be registered with
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">PAN_ID</fo:inline>
               </fo:basic-link> and/or <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.EXTENDED_PAN_ID">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">EXTENDED_PAN_ID</fo:inline>
               </fo:basic-link> properties. These properties indicate the network
    targeted by the listener since an OSGi platform can host multiple ZigBee
    networks.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A filter can be set to limit the events for which a bundle is
    notified. The ZigBee Base driver must register a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLEventListener</fo:inline>
               </fo:basic-link>
    service for every attribute report configured in the configure reporting
    commands it receives from the network.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The filter refers to the combination of the properties registered
    with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLEventListener</fo:inline>
               </fo:basic-link> service. Each <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLEventListener</fo:inline>
               </fo:basic-link>
    MUST be registered with all the following mandatory properties:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e1410">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1411">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLCluster.ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ID</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.cluster.id/Integer</fo:inline>)
        Only events generated by endpoints matching a specific cluster are
        delivered.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1417">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLAttribute.ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ID</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.attribute.id/Integer</fo:inline>)
        Only events generated by endpoints matching a specific attribute are
        delivered.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1423">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLEventListener.ATTRIBUTE_DATA_TYPE">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ATTRIBUTE_DATA_TYPE</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.attribute.datatype/Short</fo:inline>) The Attribute data type
        field contains the data type of the attribute that is to be reported
        (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="service.zigbee-ref-zigbee-cluster-library-specification">
                              <fo:inline color="inherit"
                                         font-family="inherit"
                                         letter-spacing="inherit"
                                         hyphenate="inherit">[2] <fo:inline font-style="italic">ZigBee Cluster Library Specification</fo:inline>
                              </fo:inline>
                           </fo:basic-link>
        2.4.7.1.4 Attribute Data Type Field).</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The optional properties are:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e1432">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1433">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.IEEE_ADDRESS">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">IEEE_ADDRESS</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.ieee.address/BigInteger</fo:inline>) Only events
        generated by endpoints matching the specific node are
        delivered.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1439">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.ENDPOINT_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ENDPOINT_ID</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.endpoint.id/Short</fo:inline>) Only
        events matching a specific endpoint are delivered.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1445">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLEventListener.MIN_REPORT_INTERVAL">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">MIN_REPORT_INTERVAL</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.attribute.min.report.interval/Integer</fo:inline>) The
        minimum interval, in seconds, between issuing reports of the specified
        attribute (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="service.zigbee-ref-zigbee-cluster-library-specification">
                              <fo:inline color="inherit"
                                         font-family="inherit"
                                         letter-spacing="inherit"
                                         hyphenate="inherit">[2] <fo:inline font-style="italic">ZigBee Cluster Library Specification</fo:inline>
                              </fo:inline>
                           </fo:basic-link>. –
        2.4.7.1.5).</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1453">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLEventListener.MAX_REPORT_INTERVAL">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">MAX_REPORT_INTERVAL</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.attribute.max.report.interval/Integer</fo:inline>) The
        maximum interval, in seconds, between issuing reports of the specified
        attribute (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="service.zigbee-ref-zigbee-cluster-library-specification">
                              <fo:inline color="inherit"
                                         font-family="inherit"
                                         letter-spacing="inherit"
                                         hyphenate="inherit">[2] <fo:inline font-style="italic">ZigBee Cluster Library Specification</fo:inline>
                              </fo:inline>
                           </fo:basic-link>.
        2.4.7.1.6).</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e1461">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLEventListener.REPORTABLE_CHANGE">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">REPORTABLE_CHANGE</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.attribute.reportable.change/Double</fo:inline>) The minimum
        change to the attribute that will result in a report being issued.
        This property is mandatory if the data type is <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">analog</fo:inline>. If
        the data type is <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">digital</fo:inline>, the base driver will ignore
        it.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">If the endpoint sets a timeout between two attribute reports, the
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener.notifyTimeOut-int-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">notifyTimeOut(int)</fo:inline>
               </fo:basic-link> method is then called with the timeout argument.
    In the import situation, the base driver calls this method on the relevant
    listeners when it receives a configure reporting command with a set
    TIMEOUT_PERIOD field (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-ref-zigbee-cluster-library-specification">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[2] <fo:inline font-style="italic">ZigBee Cluster Library Specification</fo:inline>
                  </fo:inline>
               </fo:basic-link> 2.4.7
    Configure Reporting Command). In the export situation, the local endpoint
    calls this method on relevant listeners and, in case the base driver is
    one of the notified listeners, it sends a configure reporting request with
    the appropriate TIMEOUT_PERIOD field to interested endpoints on the
    network.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A ZigBee event is represented by a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEvent">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEvent</fo:inline>
               </fo:basic-link>
    object.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">If an event is generated by either the local endpoint or via the
    base driver for an external device, the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener.notifyEvent-ZigBeeEvent-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">notifyEvent(ZigBeeEvent)</fo:inline>
               </fo:basic-link> method is called on all registered <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLEventListener</fo:inline>
               </fo:basic-link>
    services for which the source event matches the service properties. The
    way events must be delivered is the same as described in Delivering Events
    in the Life Cycle Layer chapter of the <fo:inline color="inherit"
                          font-family="inherit"
                          letter-spacing="inherit"
                          hyphenate="inherit">???</fo:inline> specification.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The ZigBee base driver SHOULD group subscriptions into one configure
    reporting request to the targeted ZigBee device. It SHOULD also notify
    every listener with respect to their specific expectations.</fo:block>
         </fo:block>
         <fo:block id="d1850e1491">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Monitoring Events and Sending Commands</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.22</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Monitoring Events and Sending Commands</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">In the example below, a button of the user interface monitors the
    state (on or off) of a smart plug and enables the user to switch the plug
    on and off. To monitor the plug state, a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLEventListener</fo:inline>
               </fo:basic-link>
    is registered with the properties related to the node, endpoint, cluster
    and attribute representing the plug and its state. When an appropriate
    event is sent on the network, the base driver (or a local endpoint
    implementer) notifies the listener. The listener then changes the state
    value shown by the button. When the user clicks on the button, a command
    is invoked on the plug.</fo:block>
            <fo:block space-before.minimum="0.8em"
                      space-before.optimum="1em"
                      space-before.maximum="1.2em"
                      space-after.minimum="0.8em"
                      space-after.optimum="1em"
                      space-after.maximum="1.2em"
                      hyphenate="false"
                      wrap-option="no-wrap"
                      white-space-collapse="false"
                      white-space-treatment="preserve"
                      linefeed-treatment="preserve"
                      text-align="start"
                      font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                      font-size="9pt"
                      letter-spacing="-.0em"
                      space-before="5pt"
                      space-after="3pt"
                      space-after.conditionality="retain"
                      start-indent="inherit"
                      line-height="11pt"
                      id="d1850e1497">public class UIOnOffButton implements ZCLEventListener {
    public UIOnOffButton(BigInteger ieeeAddress, Short endpointId, Integer 
            clusterId, Integer attributeId, Short dataType, 
            BundleContext bc) {
        Dictionary properties = new Hashtable();
        properties.put(ZigBeeNode.IEEE_ADDRESS, ieeeAddress);
        properties.put(ZigBeeEndpoint.ENDPOINT_ID, endpointId);
        properties.put(ZCLCluster.ID, clusterId);
        properties.put(ZCLAttribute.ID, attributeId);
        properties.put(ZCLEventListener.ATTRIBUTE_DATA_TYPE, dataType);
        // events will be filtered by the basedriver call notifyEvent() method
        // only when the event comes from a node, endpoint, cluster, attribute
        // matching these properties
        bc.registerService(ZCLEventListener.class.getName(), this, properties);
    }

    public void notifyEvent(ZigBeeEvent event) {
        // change the attribute value of the UICluster
        Object value = event.getValue();
        changeUIValue(value);
    }   
     
    public void notifyTimeOut(int timeout) {
          log.info("Timeout notified");
    }

    public void onFailure(ZCLException e) {
          log.info("Failure registering the listener: " + e);
    }
        
    public void changeUIValue(Object value) {
    ....
    }
    
    public void onClick() {
        // the button has been clicked
        // get the ZCLCluster
        ServiceReference[] srs = bundleContext.getServiceReferences(
                          ZigBeeEndpoint.class.getName(),
                          "(&amp;(" + ZigBeeNode.IEEE_ADDRESS + "=" + ieeeAddress 
                          + ")(" + ZigBeeEndpoint.ENDPOINT_ID + "=" + endpointID 
                          + "))");
        if (srs.length&gt;0){
            ZCLCluster onOffCluster =
                ((ZigBeeEndpoint) bundleContext.getService(srs[0]))
                          .getServerCluster(ZCL_ONOFF_CLUSTER_ID);
            if (onOffCluster != null) {
                final Promise p = onOffCluster.invoke(new ToggleCommand());
                p.onResolve(new Runnable() {
                    public void run(){
                        try { 
                            ZCLFrame frame = (ZCLFrame) p.getValue();
                            log.info("toggle command returned success.");
                        } catch (InvocationTargetException e) {
                            log.info("toggle command returned a failure: " 
                                      + e + ”.”);
                        } catch (InterruptedException e) {
                             e.printStackTrace();
                        }
                    }
                });
            }
        }
    }
    
    class ToggleCommand implements ZCLFrame {
        ...
    }
...
}</fo:block>
         </fo:block>
