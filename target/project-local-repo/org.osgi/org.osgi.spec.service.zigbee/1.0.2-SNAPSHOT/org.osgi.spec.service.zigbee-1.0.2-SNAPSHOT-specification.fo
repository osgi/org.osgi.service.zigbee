      <fo:flow flow-name="xsl-region-body" start-indent="1in" end-indent="0pt">
         <fo:block id="service.zigbee">
            <fo:block font-family="ProductusSemibold,ArialUnicodeMS">
               <fo:block margin-left="0pt">
                  <fo:block font-size="24.8832pt" font-weight="bold">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               keep-with-next.within-column="always"
                               space-before.optimum="0in"
                               space-before.minimum="0in"
                               space-before.maximum="0in"
                               hyphenate="false"
                               text-align="start"
                               start-indent="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS"
                               font-size="28pt"
                               line-height="35pt"
                               font-weight="normal"
                               space-after="24pt">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>149</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Device Service Specification for ZigBee™ Technology</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                  </fo:block>
                  <fo:block>
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               font-family="ProductusOSGiBookcItalic"
                               font-size="18pt"
                               line-height="25pt">
                        <fo:basic-link internal-destination="org.osgi.service.zigbee">
                           <fo:inline color="inherit"
                                      font-family="inherit"
                                      letter-spacing="inherit"
                                      hyphenate="inherit">Version 1.0</fo:inline>
                        </fo:basic-link>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d1850e87">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Introduction</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.1</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Introduction</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-ref-zigbee-specification">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[1] <fo:inline font-style="italic">ZigBee Specification</fo:inline>
                  </fo:inline>
               </fo:basic-link> is a
    standard wireless communication protocol designed for low-cost and
    low-power devices from the ZigBee Alliance. ZigBee is widely supported by
    various types of devices such as smart meters, lights and many kinds of
    sensors in the residential area. OSGi applications need to communicate
    with those ZigBee devices.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This specification defines how OSGi bundles can be developed to
    discover and control ZigBee devices on the one hand, and act as ZigBee
    devices and interoperate with ZigBee clients on the other hand. In
    particular, a Java mapping is provided for the standard hierarchical
    representation of ZigBee devices called the ZigBee Cluster Library. The
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-ref-zigbee-cluster-library-specification">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[2] <fo:inline font-style="italic">ZigBee Cluster Library Specification</fo:inline>
                  </fo:inline>
               </fo:basic-link>
    also describes the external API of a ZigBee Base Driver based upon the
    OSGi Device Access Specification.</fo:block>
         </fo:block>
         <fo:block id="d1850e97">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Essentials</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.2</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Essentials</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e99">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e100">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Scope</fo:inline> – This specification is
        limited to general device discovery and control aspects of the ZigBee
        and the ZigBee Cluster Library specifications. Aspects concerning the
        representation of specific ZigBee profiles are not addressed.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e105">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Transparency</fo:inline> – ZigBee devices
        discovered on the network and devices locally implemented on the
        platform are represented in the OSGi service registry with the same
        API.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e110">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Lightweight implementation
        option</fo:inline> – The full description of ZigBee device services on
        the OSGi platform is optional. Some base driver implementations may
        implement all the classes including ZigBee device description classes
        while implementations targeting constrained devices are able to
        implement only the part that is necessary for ZigBee device discovery
        and control.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e115">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Network Selection</fo:inline> – It must
        be possible to restrict the use of the ZigBee protocols to a selection
        of the connected networks.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e120">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Logical node type selection</fo:inline> –
        It is possible to make an OSGi-based device appearing as a ZigBee end
        device, a ZigBee router or a ZigBee coordinator.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e125">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Event handling</fo:inline> – Bundles are
        able to listen to ZigBee events.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e130">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Discover and Control ZigBee Endpoints as
        OSGi services</fo:inline> – available ZigBee endpoints are dynamically
        reified as OSGi services in the service registry.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e135">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Export OSGi services as ZigBee
        Endpoints</fo:inline> – available ZigBee endpoints are dynamically
        reified as OSGi services in the service registry.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block id="d1850e140">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Entities</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.3</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Entities</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e142">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e143">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Base Driver</fo:inline> – The
        bundle that implements the bridge between OSGi and ZigBee
        networks.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e148">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Node</fo:inline> – A physical
        ZigBee node. This entity is represented by a ZigBeeNode object. It is
        registered as an OSGi service by the Base Driver.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e153">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Endpoint</fo:inline> – A logical
        device that defines a communication entity within a ZigBee node
        through which a specific application profile is carried. This concept
        is represented by a ZigBeeEndpoint object. Registered as an OSGi
        service, an endpoint can be local (implemented on the Framework) or
        external (implemented by another device on the network).</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e158">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Device Description</fo:inline> –
        Statically describes a ZigBee endpoint by providing its input/output
        clusters and specifies which of described commands and attributes are
        mandatory or not. This entity is represented by a
        ZigBeeDeviceDescription object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e163">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Device Description Set</fo:inline>
        – A service representing a set of ZigBeeDeviceDescription
        objects.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e168">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Cluster</fo:inline> – Represents a
        ZigBee cluster entity, that is, a set of attributes and commands. It
        allows the read and write of attribute values, and allows command
        invocation. This concept is represented by a ZCLCluster object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e173">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Cluster Description</fo:inline> –
        Cluster description provides details about available commands and
        attributes for a specific Cluster. A cluster description should be
        constant. A cluster description holds either a Client or a Server
        Cluster description and refers to a global cluster description.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e178">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Global Cluster
        Description</fo:inline> – Global cluster description holds the server
        and client cluster description as well as common information such as
        cluster id, description and name. This concept is represented by a
        ZCLGlobalClusterDescription object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e183">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Command Description</fo:inline> –
        Statically describes a specific cluster command by giving its name,
        id, parameters. This entity is represented by a ZCLCommandDescription
        object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e188">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Parameter Description</fo:inline>
        – A ZigBee parameter description has a name, a range and a data type.
        This entity description is represented by a ZCLParameterDescription
        object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e193">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Attribute</fo:inline> – Holds the
        current value of an existing cluster attribute, it allows easy
        (de)encoding. This concept is represented by a ZCLAttribute
        object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e199">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Attribute Description</fo:inline>
        – Statically describes a ZigBee Attributes (data type, name, default
        value). It does not hold any current value. This concept is
        represented by a ZCLAttributeDescription object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e204">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Event Listener Service</fo:inline>
        – A service that listens to events coming from ZigBee devices.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e209">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Event</fo:inline> – An event
        generated by a ZigBee node. It contains a modified attribute value of
        a specific cluster. This concept is represented by a ZigBeeEvent
        object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e214">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Command Response
        Stream</fo:inline> – A stream is a helper that manages asynchronous
        responses from several endpoints that received a same request message.
        This entity is represented by a ZigBeeCommandResponseStream. For
        methods that generates a message to a unique endpoint, a <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">Promise</fo:inline> is used instead.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e222">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Host</fo:inline> – The machine
        that hosts the code to run a ZigBee device or client. It contains
        information related to the Host. If the host is in the coordinator
        logical node type, it enables networking configuration. It is
        registered as an OSGi service. This concept is represented by
        ZigBeeHost.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e227">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Client</fo:inline> – An
        application that is intended to control ZigBee devices
        services.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e232">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">ZigBee Group</fo:inline> – Enables group
        management. It is registered as an OSGi service.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block start-indent="0pt">
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="service.zigbee-figure_id_20160712_18h51_11">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 149.1</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>ZigBee Service Specification class Diagram
      org.osgi.service.zigbee package</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d1850e239" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.zigbee/spec/org.osgi.spec.service.zigbee/src/main/resources/spec/ZigBeeClassDiagram.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="6in"
                                          content-height="auto"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d1850e242">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Operation Summary</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.4</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Operation Summary</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">OSGi applications interact with ZigBee devices through their object
    representation (proxies) registered in OSGi service registry. To make a
    ZigBee device available as an OSGi service to ZigBee clients on the
    framework, an OSGi service object must be registered under the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link>
    interface with the OSGi framework and an OSGi service must be registered
    under the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link> interface with the OSGi framework for every
    endpoint that is contained by the ZigBee node.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The ZigBee Base Driver is responsible for mapping networked devices
    into <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link>
    objects, through the use of a ZigBee radio chip. The latter is represented
    on the OSGi framework as an object implementing <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeHost">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeHost</fo:inline>
               </fo:basic-link>
    interface. This is called a <fo:inline font-style="italic">device
    import</fo:inline> situation (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-figure_id_20160712_18h54_13">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 149.2 on page <fo:page-number-citation ref-id="service.zigbee-figure_id_20160712_18h54_13"/>
                  </fo:inline>
               </fo:basic-link>).</fo:block>
            <fo:block space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="always"
                      id="service.zigbee-figure_id_20160712_18h54_13">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Figure 149.2</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>ZigBee device import</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="d1850e265" text-align="center">
                  <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.zigbee/spec/org.osgi.spec.service.zigbee/src/main/resources/spec/DeviceImport-2.svg)"
                                       width="auto"
                                       height="auto"
                                       content-width="5.1in"
                                       content-height="7in"
                                       text-align="center"/>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">OSGi bundles may also expose framework-internal (local) <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link>
    instances, registered within the framework (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-export-figure_id_20160712_18h57_18">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 149.3 on page <fo:page-number-citation ref-id="service.zigbee-export-figure_id_20160712_18h57_18"/>
                  </fo:inline>
               </fo:basic-link>). The Base Driver then should
    emulate those objects as ZigBee endpoints associated to the ZigBee node
    represented by the underlying ZigBee host (ZigBee chip) on the ZigBee
    network. This is a <fo:inline font-style="italic">device export</fo:inline>
    situation. For more information about this process, please report to
    section <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee.implementinganendpoint">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">
                     <fo:inline font-style="italic">Implementing a ZigBee Endpoint</fo:inline> on page <fo:page-number-citation ref-id="service.zigbee.implementinganendpoint"/>
                  </fo:inline>
               </fo:basic-link>.</fo:block>
            <fo:block space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="always"
                      id="service.zigbee-export-figure_id_20160712_18h57_18">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Figure 149.3</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>ZigBee device export</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="d1850e281" text-align="center">
                  <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.zigbee/spec/org.osgi.spec.service.zigbee/src/main/resources/spec/DeviceExport-2.svg)"
                                       width="auto"
                                       height="auto"
                                       content-width="4.5in"
                                       content-height="auto"
                                       text-align="center"/>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">To control ZigBee devices, a bundle should track <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link>
    services in the OSGi service registry and control them appropriately. OSGi
    applications can browse the clusters (ZCLCluster objects) that are
    discovered on every registered <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link>
    and attributes (ZCLAttribute objects) that are discovered on every <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCluster">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCluster</fo:inline>
               </fo:basic-link>. They
    can invoke commands on these clusters and get the current value of
    attributes.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Several methods obey an asynchronous mechanism. For instance, ZigBee
    command invocation is made through the call to ZCLCluster invoke method
    that returns a <fo:inline color="blue"
                          font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          letter-spacing="0.08em"
                          hyphenate="false">Promise</fo:inline>. When the command response is
    received, the Promise is resolved and <fo:inline color="blue"
                          font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          letter-spacing="0.08em"
                          hyphenate="false">Promise.getValue()</fo:inline> returns the expected
    response value. The Promise is resolved by the base driver in the device
    import situation and by the invoked local <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCluster">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCluster</fo:inline>
               </fo:basic-link> in
    the device export situation. A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCommandResponseStream">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCommandResponseStream</fo:inline>
               </fo:basic-link> is used instead of a Promise in case of a method
    that generates a message broadcast (or groupcast) to potentially several
    endpoints.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">OSGi bundles – called listeners in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-figure_id_20160712_18h51_11">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 149.1</fo:inline>
               </fo:basic-link> – subscribe to attribute value changes
    through the Whiteboard Pattern (<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-ref-whiteboard-pattern">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[6] <fo:inline font-style="italic">Listeners considered harmful: The whiteboard pattern</fo:inline>
                  </fo:inline>
               </fo:basic-link>). They register an
    object under the ZCLEventListener interface with properties identifying a
    ZigBee attribute and a special event filter. This registration is conveyed
    as a ZigBee configure report command on the ZigBee network in the device
    import situation. Reports are received by the base driver and transmitted
    as <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener.notifyEvent-ZigBeeEvent-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">notifyEvent(ZigBeeEvent)</fo:inline>
               </fo:basic-link> method calls on relevant <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLEventListener</fo:inline>
               </fo:basic-link>
    services in this situation. Local <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link>
    objects directly call these methods to notify listeners with reports in
    the export situation. The Base Driver conveys events received through a
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLEventListener">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLEventListener</fo:inline>
               </fo:basic-link> to networked the ZigBee endpoints that have
    subscribed to relevant reports.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Endpoints, clusters, commands and attributes are specified by ZigBee
    Alliance or vendor-specific descriptions. Those descriptions may be
    provided on the OSGi platform by any bundle through the registration of
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescriptionSet">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDeviceDescriptionSet</fo:inline>
               </fo:basic-link> services (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-description-figure_id_20160713_9h17_17">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 149.4 on page <fo:page-number-citation ref-id="service.zigbee-description-figure_id_20160713_9h17_17"/>
                  </fo:inline>
               </fo:basic-link>). Every service is a set of
    descriptions that enables applications to retrieve information about the
    clusters, commands, attributes supported by the described type of
    endpoint.</fo:block>
            <fo:block space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="always"
                      id="service.zigbee-description-figure_id_20160713_9h17_17">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Figure 149.4</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Using a set of device descriptions</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="d1850e327" text-align="center">
                  <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.zigbee/spec/org.osgi.spec.service.zigbee/src/main/resources/spec/device_description_set.svg)"
                                       width="auto"
                                       height="auto"
                                       content-width="5.1in"
                                       content-height="auto"
                                       text-align="center"/>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d1850e330">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Base Driver</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.5</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Base Driver</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Most of the functionality described in the operation summary is
    implemented in a ZigBee base driver. A ZigBee base driver is a bundle that
    implements the ZigBee protocols and handles the interaction with bundles
    that use the ZigBee devices. It must discover ZigBee devices on the ZigBee
    network and map each discovered device into an OSGi registered <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link>
    service. It must also export, on the ZigBee Network, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link>
    services (programmatically registered as OSGi services).</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link> object also provides simple methods to handle
    standard ZigBee Device Object networking features: <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.getLinksQuality--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getLinksQuality()</fo:inline>
               </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.getRoutingTable--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getRoutingTable()</fo:inline>
               </fo:basic-link>, and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode.leave--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">leave()</fo:inline>
               </fo:basic-link>.</fo:block>
            <fo:block space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="always"
                      id="service.zigbee-cluster-figure_id_20160713_9h46_22">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Figure 149.5</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>ZigBee Cluster Library model</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="d1850e349" text-align="center">
                  <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.zigbee/spec/org.osgi.spec.service.zigbee/src/main/resources/spec/clusterLibrairie.svg)"
                                       width="auto"
                                       height="auto"
                                       content-width="4in"
                                       content-height="auto"
                                       text-align="center"/>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">All interfaces corresponding to the ZigBee Cluster Library model
    (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-cluster-figure_id_20160713_9h46_22">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 149.5 on page <fo:page-number-citation ref-id="service.zigbee-cluster-figure_id_20160713_9h46_22"/>
                  </fo:inline>
               </fo:basic-link>) must be implemented in order
    to discover and control asynchronously ZigBee devices. Classes related to
    the description of these entities named with suffix
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Description</fo:inline> may optionally be implemented. This rule follows
    the fact that ZigBee device descriptions are not downloadable on the
    device itself and are often given to developers in an out-of-band
    manner.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Several base drivers may be deployed on a residential OSGi device,
    one for every supported network technology. An OSGi device abstraction
    layer may then be implemented as a layer of refining drivers above a layer
    of base drivers. The refining driver is responsible for adapting
    technology-specific device services registered by the base driver into
    device services of another model (see AbstractDevice interface in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-basedriver-figure_id_20160713_9h23_46">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 149.6 on page <fo:page-number-citation ref-id="service.zigbee-basedriver-figure_id_20160713_9h23_46"/>
                  </fo:inline>
               </fo:basic-link>). In the case of a generic
    device abstraction layer, the model is agnostic to technologies.</fo:block>
            <fo:block start-indent="0pt">
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="service.zigbee-basedriver-figure_id_20160713_9h23_46">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 149.6</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>The ZigBee Base Driver and a refining driver representing devices
      in an abstract model</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d1850e364" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.zigbee/spec/org.osgi.spec.service.zigbee/src/main/resources/spec/RefinedDriver-2.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="6in"
                                          content-height="4in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The ZigBee Alliance defines their own abstract model with ZigBee
    Profiles, for example, Home Automation, Lighting, and refining drivers may
    provide the implementation of all ZigBee standard devices with
    ZigBee-specific Java interfaces. The AbstractDevice interface of <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-basedriver-figure_id_20160713_9h23_46">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 149.6 on page <fo:page-number-citation ref-id="service.zigbee-basedriver-figure_id_20160713_9h23_46"/>
                  </fo:inline>
               </fo:basic-link> is then replaced by a
    ZigBee-specific Java interface in that case. The need and the choice of
    the abstraction depends on the targeted application domain.</fo:block>
         </fo:block>
         <fo:block id="d1850e371">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Node</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.6</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Node</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A ZigBee node represents a physical ZigBee device and should adhere
    to a specific application profile that can be either public or private.
    Profiles define the environment of the application, the type of devices
    and the clusters used for them to communicate.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A physical device is reified and registered as a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link>
    service in the Framework. A ZigBee node holds several ZigBee endpoints
    that are registered as <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link>
    objects.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">ZigBee nodes properties are defined in the ZigBee Specification.
    These properties must be registered in the OSGi Framework services
    registry so they are searchable. <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link> must
    be registered with the following properties:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e384">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e385">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.IEEE_ADDRESS">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">IEEE_ADDRESS</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.ieee.address/BigInteger</fo:inline>) specifies the IEEE
        Address of a ZigBee node.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e391">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.LOGICAL_TYPE">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">LOGICAL_TYPE</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.description.node.type/Short</fo:inline>) specifies a
        device logical type.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e397">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.MANUFACTURER_CODE">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">MANUFACTURER_CODE</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.description.manufacturer.code/Integer</fo:inline>)
        specifies a manufacturer code that is allocated by the ZigBee
        Alliance, relating to the device manufacturer.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e403">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.POWER_SOURCE">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">POWER_SOURCE</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.power.source/Boolean</fo:inline>) is the ZigBee power
        source, that is, 3rd bit of "MAC Capabilities" in Node Descriptor,
        which is set to 1 if the current power source is mains power, set to 0
        otherwise.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e409">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.RECEIVER_ON_WHEN_IDLE">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">RECEIVER_ON_WHEN_IDLE</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.receiver.on.when.idle/Boolean</fo:inline>) represents
        the ZigBee receiver on when idle, that is, 4th bit of "MAC
        Capabilities" in Node Descriptor, which is set to 1 if the device does
        not disable its receiver to conserve power during idle periods, set to
        0 otherwise.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e415">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.PAN_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">PAN_ID</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.pan.id/Integer</fo:inline>)
        (Personal Area Network Identifier) is a 16-bit value that identifies a
        ZigBee network. Every <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZigBeeNode</fo:inline>
                           </fo:basic-link>
        object is associated to a PAN ID, which can be retrieved through the
        <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.getPanId--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getPanId()</fo:inline>
                           </fo:basic-link> method.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e425">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.EXTENDED_PAN_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">EXTENDED_PAN_ID</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.pan.extended.id/BigInteger</fo:inline>) Extended PAN ID
        is a 64-bit numbers that uniquely identify a PAN. It is intended to
        enhance selection of a PAN and enable recognition of network after PAN
        ID change (due to a previous conflict). <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.getExtendedPanId--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getExtendedPanId()</fo:inline>
                           </fo:basic-link> returns the network extended PAN ID if
        specified.</fo:block>
                        <fo:block space-before.optimum="5pt"
                                  space-before.minimum="5pt"
                                  space-before.maximum="5pt">Note: <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.PAN_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">PAN_ID</fo:inline>
                           </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.EXTENDED_PAN_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">EXTENDED_PAN_ID</fo:inline>
                           </fo:basic-link> are optional, but at least one of these
        properties MUST be specified.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e439">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">DEVICE_CATEGORY</fo:inline> (see the OSGi Device
        Access Specification) – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">DEVICE_CATEGORY</fo:inline>) describes a
        table of the categories to which the device belongs. One of the values
        MUST be “ZigBee” (<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.DEVICE_CATEGORY">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">DEVICE_CATEGORY</fo:inline>
                           </fo:basic-link>).</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Additional properties (defined in the OSGi Device Access
    Specification) may be set:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e449">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e450">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">DEVICE_DESCRIPTION</fo:inline> – if the complex
        descriptor of the device is available, the value MUST be set and MUST
        be the value returned by <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptors.ZigBeeComplexDescriptor.getModelName--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getModelName()</fo:inline>
                           </fo:basic-link>.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e457">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">DEVICE_SERIAL</fo:inline> – if the complex descriptor
        of the device is available, the value MUST be set and MUST be the
        value returned by <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptors.ZigBeeComplexDescriptor.getSerialNumber--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getSerialNumber()</fo:inline>
                           </fo:basic-link>.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Finally, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">service.pid</fo:inline> property MUST be set.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">ZigBee nodes describes themselves using descriptor data
    structures:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e469">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e470">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.getNodeDescriptor--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getNodeDescriptor()</fo:inline>
                           </fo:basic-link> – Returns a <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">Promise</fo:inline> object that is asynchronously
        resolved with a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptors.ZigBeeNodeDescriptor">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZigBeeNodeDescriptor</fo:inline>
                           </fo:basic-link> object representing the Node Descriptor which
        contains information about the node capabilities. On failure, the
        promise is resolved with an exception instead.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e479">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.getComplexDescriptor--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getComplexDescriptor()</fo:inline>
                           </fo:basic-link> – Returns a <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">Promise</fo:inline> object that is asynchronously
        resolved with a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptors.ZigBeeComplexDescriptor">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZigBeeComplexDescriptor</fo:inline>
                           </fo:basic-link> object representing the Complex Descriptor
        which contains extended information for each device description
        contained in this node. On failure, the promise is resolved with an
        exception instead, especially an exception with <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZDPException.NO_DESCRIPTOR">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">NO_DESCRIPTOR</fo:inline>
                           </fo:basic-link> error code if no Complex Descriptor is
        provided.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e490">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.getPowerDescriptor--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getPowerDescriptor()</fo:inline>
                           </fo:basic-link> – Returns a <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">Promise</fo:inline> object that is asynchronously
        resolved with a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptors.ZigBeePowerDescriptor">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZigBeePowerDescriptor</fo:inline>
                           </fo:basic-link> object representing the Power Descriptor which
        contains power-related information of this node. On failure, the
        promise is resolved with an exception instead, especially an exception
        with <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZDPException.NO_DESCRIPTOR">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">NO_DESCRIPTOR</fo:inline>
                           </fo:basic-link> error code if no Power Descriptor is
        provided.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e501">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.getUserDescription--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getUserDescription()</fo:inline>
                           </fo:basic-link> – Returns a <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">Promise</fo:inline> object that is asynchronously
        resolved with the unique field named “User description” of the User
        Descriptor, which contains information that allows the user to
        identify the device using user-friendly character string. On failure,
        the promise is resolved with an exception instead, especially an
        exception with <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZDPException.NO_DESCRIPTOR">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">NO_DESCRIPTOR</fo:inline>
                           </fo:basic-link> error code if no User Descriptor is
        provided.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link> objects provide <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">invoke</fo:inline> methods to
    send network frames within ZDP layer, while invoking ZigBee Cluster
    Library (ZCL) commands is enabled on <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCluster">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCluster</fo:inline>
               </fo:basic-link>
    objects. ZCL commands can be however broadcast on a ZigBee node thanks to
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">broadcast</fo:inline> methods. Broadcasting enables the sending of a ZCL
    command to all clusters identified with an identifier of all endpoints
    available on the targeted ZigBee node.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">All discovered ZigBee nodes in the local networks are registered
    under the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link> interface within the OSGi Framework. Every time a
    ZigBee node appears or quits the network, the associated OSGi service is
    registered or unregistered in the OSGi service registry. Thanks to the
    ZigBee Base Driver, the OSGi service availability in the registry mirrors
    ZigBee device availability on ZigBee networks. Using a remote ZigBee node
    thus involves tracking <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link> services in the OSGi service registry. The
    following code illustrates how this can be done. The sample
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Controller</fo:inline> class extends the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">ServiceTracker</fo:inline>
    class so that it can track all <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link>
    services and add them to a user interface, such as a remote controller
    application. The friendly name of this node is retrieved in order to be
    printed on the user interface.</fo:block>
            <fo:block space-before.minimum="0.8em"
                      space-before.optimum="1em"
                      space-before.maximum="1.2em"
                      space-after.minimum="0.8em"
                      space-after.optimum="1em"
                      space-after.maximum="1.2em"
                      hyphenate="false"
                      wrap-option="no-wrap"
                      white-space-collapse="false"
                      white-space-treatment="preserve"
                      linefeed-treatment="preserve"
                      text-align="start"
                      font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                      font-size="9pt"
                      letter-spacing="-.0em"
                      space-before="5pt"
                      space-after="3pt"
                      space-after.conditionality="retain"
                      start-indent="inherit"
                      line-height="11pt"
                      id="d1850e532">class Controller extends ServiceTracker {
    UI ui;
    Controller( BundleContext context ) {
        super( context, ZigBeeNode.class, null );
    }
    public Object addingService( ServiceReference ref ) {
        ZigBeeNode node = (ZigBeeNode)super.addingService(ref);
        ui.addNode( node );
        return node;
    }
    public void removedService( ServiceReference ref, Object endpoint ) {
        ui.removeNode( (ZigBeeNode) node );
        super.removedService(ref);
    }
    ...
}

public class UI {
    public void addNode(ZigBeeNode node) {
        final Promise p = node.getUserDescription();
        p.onResolve(new Runnable() {
            public void run() {
                try { 
                    String friendlyName = (String) p.getValue();
                    createUINode(node, friendlyName);
                } catch (InvocationTargetException e) {
                     log.info("Get User Description command returned "
                               + "a failure: " + e.getCause() + ”.”);
                     createUINode(node, "No friendly name");
                } catch (InterruptedException e) {
                     e.printStackTrace();
                }
            }
        });
    }
...
}</fo:block>
         </fo:block>
         <fo:block id="d1850e533">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Endpoint</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.7</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Endpoint</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Communication between devices is done through an addressable
    component called ZigBee endpoint which holds a number of ZigBee clusters.
    A ZigBee cluster represents a functional unit in a device.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">An endpoint defines a communication entity within a device through
    which a specific application is carried. So, it represents a logical
    device object used for communication.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">For example, a remote control light might allocate Endpoint 7 for
    the control of lights in the master bedroom, Endpoint 9 to manage the
    heating and air conditioning system, and Endpoint 14 for controlling the
    security system.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The ZigBee specification defines that a maximum of 240 Endpoints is
    allowed per <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeNode</fo:inline>
               </fo:basic-link>. Endpoint 0, also called the ZigBee Device Object
    (ZDO), is reserved for the management operations on both ZigBee node and
    ZigBee endpoints, endpoint 255 is reserved for broadcasting to all
    endpoints, endpoints 241-254 are reserved for future use.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Endpoint 0 and endpoint 255 capabilities are not exposed, only
    endpoints 1-240 should be registered as services. Endpoints are registered
    under the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link> interface with the following properties:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e546">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e547">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.IEEE_ADDRESS">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">IEEE_ADDRESS</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.node.ieee.address/BigInteger</fo:inline>) specifies the IEEE
        Address of the parent node.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e553">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.ENDPOINT_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ENDPOINT_ID</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.endpoint.id/Short</fo:inline>)
        specifies the endpoint address within the node. Applications shall
        only use endpoints 1-240.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e559">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.PROFILE_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">PROFILE_ID</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.device.profile.id/Integer</fo:inline>) identifies the profile
        that the endpoint belongs to. The profile can be either a ZigBee
        Alliance standard profile or a vendor-specific profile. The ZigBee
        specification defines several profile identifiers, and some others are
        vendor specific.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e565">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.HOST_PID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">HOST_PID</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.endpoint.host.pid/String</fo:inline>) – The ZigBee local host
        identifier is intended to uniquely identify the ZigBee local host,
        since there could be many hosts on the same platform. All the
        endpoints that belong to a specific network MUST specify the value of
        the associated host number.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e571">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.DEVICE_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">DEVICE_ID</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.device.id/Integer</fo:inline>)
        identifies the device description supported by this endpoint. Like for
        profile identifiers, the ZigBee specification defines several device
        identifiers. Vendors are also able to define specific device
        identifiers.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e577">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.DEVICE_VERSION">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">DEVICE_VERSION</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.device.version/Integer</fo:inline>)
        specifies the device description version supported by this
        endpoint.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e583">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.INPUT_CLUSTERS">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">INPUT_CLUSTERS</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.endpoint.clusters.input/Integer[]</fo:inline>) specifies the
        list of input cluster ids supported by this endpoint. Input cluster
        are called Server cluster.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e589">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.OUTPUT_CLUSTERS">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">OUTPUT_CLUSTERS</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.endpoint.clusters.output/Integer[]</fo:inline>) specifies the
        list of output cluster ids supported by this endpoint. Output cluster
        are called Client cluster.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e595">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">DEVICE_CATEGORY</fo:inline> (see the OSGi Device
        Access Specification) – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">DEVICE_CATEGORY</fo:inline>) describes a
        table of the categories to which the device belongs. One of the values
        MUST be “ZigBee” (<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.DEVICE_CATEGORY">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">DEVICE_CATEGORY</fo:inline>
                           </fo:basic-link>).</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Finally, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">service.pid</fo:inline> property MUST be set. In device
    import case, it is a free unique identifier that enables OSGi ZigBee
    clients to identify any imported endpoint across node reboots. It may
    concatenate the endpoint IEEE address, a separator, for example, '_', and
    the endpoint ID. In endpoint export case, it is a free unique identifier
    that enables the base driver to identify any exported endpoint across
    local bundle restarts. In this case, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">service.pid</fo:inline> property may
    concatenate bundle identifier, a separator, for example, '_', and a
    number.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link> may contain a number of input or output clusters.
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link> provides <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.getServerCluster-int-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getServerCluster(int)</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.getClientCluster-int-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getClientCluster(int)</fo:inline>
               </fo:basic-link> to return a specific server input or client output
    cluster.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Every endpoint must provide a simple descriptor. <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.getSimpleDescriptor--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getSimpleDescriptor()</fo:inline>
               </fo:basic-link> returns a <fo:inline color="blue"
                          font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          letter-spacing="0.08em"
                          hyphenate="false">Promise</fo:inline> object that is asynchronously
    resolved with a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptors.ZigBeeSimpleDescriptor">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeSimpleDescriptor</fo:inline>
               </fo:basic-link> object which contains general information about
    the endpoint or with an exception in case of a failure.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link> interface provides two methods to bind and unbind
    ZigBee clusters: <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.bind-String-int-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">bind(String,int)</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.unbind-String-int-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">unbind(String,int)</fo:inline>
               </fo:basic-link>. The entity that wants to bind clusters is
    responsible for initializing, maintaining and removing the bindings across
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link> service events. This entity is the local OSGi
    Application that asked this binding or the ZigBee Base Driver if the
    binding has been requested by a remote ZigBee node.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link> interface provides a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.getBoundEndPoints-int-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getBoundEndPoints(int)</fo:inline>
               </fo:basic-link> method that provides the table of bound <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeEndpoint</fo:inline>
               </fo:basic-link>
    objects identified by their service PIDs.</fo:block>
         </fo:block>
         <fo:block id="d1850e646">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Device Description</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.8</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Device Description</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A ZigBee endpoint may have a description used to describe his input
    and output clusters, and which of these clusters are mandatory or
    optional. A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDeviceDescription</fo:inline>
               </fo:basic-link> object provides associated information about an
    endpoint.</fo:block>
         </fo:block>
         <fo:block id="d1850e652">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Device Description Set</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.9</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Device Description Set</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescriptionSet">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDeviceDescriptionSet</fo:inline>
               </fo:basic-link> objects may be registered as OSGi services by any
    bundle. A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescriptionSet">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDeviceDescriptionSet</fo:inline>
               </fo:basic-link> provides <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescriptionSet.getDeviceSpecification-int-short-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getDeviceSpecification(int,short)</fo:inline>
               </fo:basic-link> which returns the device description, if provided,
    for the identified endpoint, or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">null</fo:inline> otherwise. A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescriptionSet">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDeviceDescriptionSet</fo:inline>
               </fo:basic-link> service should be registered with the following
    properties:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e665">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e666">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescriptionSet.VERSION">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">VERSION</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.profile.version/Short</fo:inline>)
        The application profile version.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e672">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.PROFILE_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">PROFILE_ID</fo:inline>
                           </fo:basic-link> – see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZigBeeEndpoint</fo:inline>
                           </fo:basic-link>.<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeEndpoint.PROFILE_ID">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">PROFILE_ID</fo:inline>
                           </fo:basic-link> property.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e680">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescriptionSet.PROFILE_NAME">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">PROFILE_NAME</fo:inline>
                           </fo:basic-link> – (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.profile.name/String</fo:inline>)
        The profile name.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e686">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.MANUFACTURER_CODE">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">MANUFACTURER_CODE</fo:inline>
                           </fo:basic-link> – see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZigBeeNode</fo:inline>
                           </fo:basic-link>.<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.MANUFACTURER_CODE">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">MANUFACTURER_CODE</fo:inline>
                           </fo:basic-link> property.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e694">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptions.ZigBeeDeviceDescriptionSet.DEVICES">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">DEVICES</fo:inline>
                           </fo:basic-link> –
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">zigbee.profile.devices/Integer[]</fo:inline>) comma separated list
        of devices identifiers supported by the set.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block id="d1850e701">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZCL Cluster</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.10</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZCL Cluster</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Devices communicate with each other by means of clusters, which may
    be inputs to or outputs of the device. For example, ZigBee Home Automation
    profile provides a cluster dedicated to the control of lighting
    subsystems. Clusters are represented under <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCluster">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCluster</fo:inline>
               </fo:basic-link>
    interface.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCluster">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCluster</fo:inline>
               </fo:basic-link> objects combine one or more ZigBee commands (or
    frames) and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttribute">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLAttribute</fo:inline>
               </fo:basic-link> objects.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCluster">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCluster</fo:inline>
               </fo:basic-link> provides some methods for reading and writing
    attributes values:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e715">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e716">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLCluster.readAttributes-ZCLAttributeInfo---">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">readAttributes(ZCLAttributeInfo[])</fo:inline>
                           </fo:basic-link> – The ZigBee Base driver MAY generate the read
        attributes command on behalf of the OSGi application that is invoking
        this method. The latter returns a <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">Promise</fo:inline> object that is asynchronously
        resolved with a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">Map</fo:inline> of <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLReadStatusRecord">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZCLReadStatusRecord</fo:inline>
                           </fo:basic-link> identified by their attribute identifiers. On
        failure, the promise is resolved with an exception instead.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e727">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLCluster.writeAttributes-boolean-Map-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">writeAttributes(boolean,Map)</fo:inline>
                           </fo:basic-link> – The ZigBee Base driver generates the write
        attributes command on behalf of the OSGi application that is invoking
        this method. The boolean <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">undivided</fo:inline> parameter specifies
        that if any attribute cannot be written, for example, if an attribute
        is not implemented on the device, or a value to be written is outside
        the valid range, no attribute values are changed.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCluster">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCluster</fo:inline>
               </fo:basic-link> objects use ZCLFrame to invoke ZigBee commands
    :</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e736">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e737">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLCluster.invoke-ZCLFrame-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">invoke(ZCLFrame)</fo:inline>
                           </fo:basic-link> – a sequence of bytes represents the command
        frame. The source endpoint is not specified in this method call. To
        send the appropriate message on the network, the base driver must
        generate a source endpoint. The latter must not correspond to any
        exported endpoint.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e741">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZCLCluster.invoke-ZCLFrame-String-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">invoke(ZCLFrame,String)</fo:inline>
                           </fo:basic-link> – a sequence of bytes represents the command
        frame, and exportedServicePID is the source endpoint of the command
        request. In targeted situations, the source endpoint is the valid
        service PID of an exported endpoint.</fo:block>
                        <fo:block space-before.optimum="5pt"
                                  space-before.minimum="5pt"
                                  space-before.maximum="5pt">A <fo:inline color="blue"
                                      font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      letter-spacing="0.08em"
                                      hyphenate="false">Promise</fo:inline> is returned and manages the
        command response asynchronously.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block id="d1850e750">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZCL Cluster Description</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.11</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZCL Cluster Description</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLClusterDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLClusterDescription</fo:inline>
               </fo:basic-link> describes the server or client part of a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCluster">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCluster</fo:inline>
               </fo:basic-link>. It
    lists the available commands and attributes for this client or server
    cluster.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Every cluster client and server may have attributes (see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.zigbee-ref-zigbee-cluster-library-specification">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[2] <fo:inline font-style="italic">ZigBee Cluster Library Specification</fo:inline>
                  </fo:inline>
               </fo:basic-link>,
    Chapter 2.2.1), received and generated commands. <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLClusterDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLClusterDescription</fo:inline>
               </fo:basic-link> provides methods to describe commands, attributes
    and retrieve general cluster information.</fo:block>
         </fo:block>
         <fo:block id="d1850e764">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZCL Global Cluster Description</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.12</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZCL Global Cluster Description</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLGlobalClusterDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLGlobalClusterDescription</fo:inline>
               </fo:basic-link> describes a cluster general information: id, name,
    description. It provides the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLClusterDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLClusterDescription</fo:inline>
               </fo:basic-link> for both client and server part of this
    cluster.</fo:block>
         </fo:block>
         <fo:block id="d1850e771">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Command Description</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.13</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Command Description</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLCommandDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCommandDescription</fo:inline>
               </fo:basic-link> describes a ZigBee command.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLCommandDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCommandDescription</fo:inline>
               </fo:basic-link> contains <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLParameterDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLParameterDescription</fo:inline>
               </fo:basic-link> objects which describe the command
    parameters.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">All clusters (server and client) shall support generation, reception
    and execution of the default response command.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Every cluster (server or client) that implements attributes shall
    support reception of, execution of, and response to all commands to
    discover, read, write, report, configure reporting of, and read reporting
    configuration of these attributes. Generation of these commands is
    application dependent.</fo:block>
         </fo:block>
         <fo:block id="d1850e783">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Attribute</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.14</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Attribute</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A ZigBee cluster is associated with a set of attributes. Every
    attribute is represented by an object implementing <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttribute">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLAttribute</fo:inline>
               </fo:basic-link>
    interface extending <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttributeInfo">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLAttributeInfo</fo:inline>
               </fo:basic-link>. <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttribute">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLAttribute</fo:inline>
               </fo:basic-link>
    provides <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttribute.getValue--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getValue()</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttribute.setValue-Object-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">setValue(Object)</fo:inline>
               </fo:basic-link> to retrieve and set the current attribute value
    with the use of a <fo:inline color="blue"
                          font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          letter-spacing="0.08em"
                          hyphenate="false">Promise</fo:inline>, which returns the response
    asynchronously.</fo:block>
         </fo:block>
         <fo:block id="d1850e801">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Attribute Description</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.15</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Attribute Description</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLAttributeDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLAttributeDescription</fo:inline>
               </fo:basic-link> also extends <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttributeInfo">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLAttributeInfo</fo:inline>
               </fo:basic-link>
    and describes information about a specific <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttribute">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLAttribute</fo:inline>
               </fo:basic-link>.</fo:block>
         </fo:block>
         <fo:block id="d1850e811">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZCL Data Type Description</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.16</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZCL Data Type Description</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttributeInfo">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLAttributeInfo</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLParameterDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLParameterDescription</fo:inline>
               </fo:basic-link> provide <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLAttributeInfo.getDataType--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getDataType()</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLParameterDescription.getDataTypeDescription--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getDataTypeDescription()</fo:inline>
               </fo:basic-link> methods, respectively, which return <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLDataTypeDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLDataTypeDescription</fo:inline>
               </fo:basic-link> objects. One object is associated to every ZigBee
    data type, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDataTypes</fo:inline>
               </fo:basic-link> constants in ZigBee Data Types section
    below.</fo:block>
         </fo:block>
         <fo:block id="d1850e826">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZCL Simple Type Description</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.17</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZCL Simple Type Description</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLSimpleTypeDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLSimpleTypeDescription</fo:inline>
               </fo:basic-link> extends <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLDataTypeDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLDataTypeDescription</fo:inline>
               </fo:basic-link> interface to provide the following methods:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e833">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e834">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptions.ZCLSimpleTypeDescription.serialize-ZigBeeDataOutput-Object-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">serialize(ZigBeeDataOutput,Object)</fo:inline>
                           </fo:basic-link> – Serializes a Java object corresponding to
        the Java data type given by <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptions.ZCLDataTypeDescription.getJavaDataType--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getJavaDataType()</fo:inline>
                           </fo:basic-link>, and adds the result to the given <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeDataOutput">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">ZigBeeDataOutput</fo:inline>
                           </fo:basic-link> according to ZigBee Cluster Library.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e842">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptions.ZCLSimpleTypeDescription.deserialize-ZigBeeDataInput-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">deserialize(ZigBeeDataInput)</fo:inline>
                           </fo:basic-link> – Deserializes the given data into a Java
        object of the Java data type given by <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.descriptions.ZCLDataTypeDescription.getJavaDataType--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getJavaDataType()</fo:inline>
                           </fo:basic-link>.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Every ZigBee data type is associated to a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLSimpleTypeDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLSimpleTypeDescription</fo:inline>
               </fo:basic-link> implementation, except ZigBee Array, Bag, Set, and
    Structure types.</fo:block>
         </fo:block>
         <fo:block id="d1850e852">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Promise and Response Stream objects</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.18</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Promise and Response Stream objects</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:inline color="blue"
                          font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          letter-spacing="0.08em"
                          hyphenate="false">
    Promise</fo:inline> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCommandResponseStream">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCommandResponseStream</fo:inline>
               </fo:basic-link> objects handle ZigBee network communication
    latency and errors. An <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">org.osgi.util.promise.Promise</fo:inline> is
    immediately returned by every method that generates a message exchange
    with one ZigBee endpoint, that is, the sending of a message to this
    endpoint and the handling of a unique response from this endpoint. No
    exception is thrown by this method. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Promise</fo:inline> handles the
    expected result and any occurring error asynchronously. The caller can
    either get a callback when the Promise is resolved with a value or an
    error, or the Promise can be used in chaining. Both
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">onResolve(Runnable)</fo:inline> callbacks and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">then(Success,
    Failure)</fo:inline> chaining can be repeated any number of times, even after
    the Promise has been resolved. When the Promise is resolved, callbacks and
    chaining are called, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Promise.isDone()</fo:inline> returns true, and
    either <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Promise.getValue()</fo:inline> returns a value or
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Promise.getFailure()</fo:inline> returns a relevant
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Throwable</fo:inline>. The type of the value and the type of Throwable
    are specific to the method returning the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Promise</fo:inline>. In import
    situations, the base driver fails the Promise when a timeout is reached
    before any response is received on the network. The returned failure is
    then a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeException">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeException</fo:inline>
               </fo:basic-link> with <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeException.TIMEOUT">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">TIMEOUT</fo:inline>
               </fo:basic-link> error code. The associated timeout is given by
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeHost.getCommunicationTimeout--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">getCommunicationTimeout()</fo:inline>
               </fo:basic-link>. It can be set by calling <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeHost.setCommunicationTimeout-long-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">setCommunicationTimeout(long)</fo:inline>
               </fo:basic-link> on the appropriate ZigBeeHost object.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCommandResponseStream">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCommandResponseStream</fo:inline>
               </fo:basic-link> is immediately returned by every method that
    generates the sending of a message to potentially several endpoints with
    the expectation of a response from several of them. No exception is thrown
    by this method. The caller can register a handler with <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCommandResponseStream.forEach-Predicate-">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">forEach(Predicate)</fo:inline>
               </fo:basic-link>. The unique method of the handler is called with a
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCommandResponse">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCommandResponse</fo:inline>
               </fo:basic-link> every time a response is received from one of the
    targeted endpoints until the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCommandResponseStream">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCommandResponseStream</fo:inline>
               </fo:basic-link> is closed. The latter is closed either when the
    handler returns false to the test method or <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCommandResponseStream.close--">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">close()</fo:inline>
               </fo:basic-link> is called. <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZCLCommandResponseStream">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLCommandResponseStream</fo:inline>
               </fo:basic-link> is used for the following message invocation
    types:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1850e903">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e904">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Broadcasting: Sending a message to all available endpoints of a
        specific type and receiving responses from each of them, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeHost.broadcast-int-ZCLFrame-String-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">broadcast(int,ZCLFrame,String)</fo:inline>
                           </fo:basic-link>.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e909">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Groupcasting: Sending a message to the endpoints of a specific
        type in a group of endpoints and receiving responses from each of
        them, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeGroup.groupcast-int-ZCLFrame-String-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">groupcast(int,ZCLFrame,String)</fo:inline>
                           </fo:basic-link>.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1850e914">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Nodecasting: Sending a message to the endpoints of a specific
        type on a node and receiving responses from each of them, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.zigbee.ZigBeeNode.broadcast-int-ZCLFrame-String-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">broadcast(int,ZCLFrame,String)</fo:inline>
                           </fo:basic-link>.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block id="d1850e919">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">ZigBee Data Types</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>149.19</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>ZigBee Data Types</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDataTypes</fo:inline>
               </fo:basic-link> class provides all standard ZigBee data type
    identifiers as constants. It should be noted that actual value of these
    constants do not necessarily match the values assigned in the ZCL
    specification for these data types.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.types">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">org.osgi.service.zigbee.types</fo:inline>
               </fo:basic-link> package contains an implementation class for each
    of the ZCL scalar data types, with the exception of <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes.NO_DATA">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">NO_DATA</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes.UNKNOWN">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">UNKNOWN</fo:inline>
               </fo:basic-link> . Each of these classes declares a static
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">getInstance()</fo:inline> method, that returns a singleton of the class
    itself. Moreover, because they implement the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.descriptions.ZCLSimpleTypeDescription">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZCLSimpleTypeDescription</fo:inline>
               </fo:basic-link> interface, they provide methods for getting some
    metadata information about the ZCL data type they represent, like the
    relative <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeDataTypes">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDataTypes</fo:inline>
               </fo:basic-link> constant ( <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">getId()</fo:inline> method) and the
    Java class the ZCL data type is mapped to. Methods to marshal and
    unmarshal the data type into a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeDataInput">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDataInput</fo:inline>
               </fo:basic-link>
    stream and from a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.zigbee.ZigBeeDataOutput">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">ZigBeeDataOutput</fo:inline>
               </fo:basic-link> stream according to the ZigBee specification, are
    provided as well.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Here is the table of encoding relations between ZigBee types and
    Java types, used in this specification:</fo:block>
            <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                      space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="auto"
                      id="d1850e947">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Table 149.1</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Mapping of ZCL Data Types to Java</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:table border-before-width.conditionality="retain"
                         border-collapse="collapse"
                         table-layout="fixed"
                         width="100%">
                  <fo:table-column column-number="1" column-width="proportional-column-width(2)"/>
                  <fo:table-column column-number="2" column-width="proportional-column-width(2)"/>
                  <fo:table-column column-number="3" column-width="proportional-column-width(1)"/>
                  <fo:table-header start-indent="0pt" end-indent="0pt">
                     <fo:table-row keep-together.within-column="always"
