                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>149.31.25.18</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract Promise&lt;Map&lt;String, ZigBeeLinkQuality&gt;&gt; getLinksQuality()</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Retrieves the link quality information to the neighbor nodes.
 
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 An implementation of this method may use the <fo:inline font-style="italic">Mgmt_Lqi_req</fo:inline> and
 <fo:inline font-style="italic">Mgmt_Lqi_rsp</fo:inline> messages to retrieve the Link Quality table (also
 known as NeighborTableList in the ZigBee Specification).
 
 </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 The method limit the Link Quality table to the {@link ZigBeeNode} service
 discovered.
 
 </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 In case of failure, the target device may report error code
 {@link ZDPException#NOT_SUPPORTED}.</fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>A promise representing the completion of this asynchronous call.
         It will be resolved with the result of this operation. In case of
         success the resolved value will be a {@link Map} containing the
         Service.PID as {@link String} key of the {@link ZigBeeNode}
         service and the value the {@link ZigBeeLinkQuality} for that
         node. In case of errors the promise must fail with the correct
         {@link ZDPException}.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
